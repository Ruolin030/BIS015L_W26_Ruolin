billboard <- read_csv("data/billboard.csv")
billboard
billboard %>%
pivot_longer(wk1:wk76,
names_to="week",
values_to="rank",
values_drop_na = T)
billboard %>%
pivot_longer(-c(artist, track, date.entered),
names_to = "week",
values_to = "rank",
values_drop_na = T)
billboard %>%
pivot_longer(
cols=starts_with("wk"),
names_to = "week",
names_prefix = "wk",
values_to = "rank",
values_drop_na = T
)
billboard %>%
pivot_longer(
cols=starts_with("wk"),
names_to = "week",
names_prefix = "wk", #gets rid of the wk
values_to = "rank",
values_drop_na = T
)
