mutate(year=as.numeric(year)) %>%
pivot_longer(-site,
names_to = "year",
values_to = "average_enterocococci_cfu_100ml") %>%
ggplot(mapping=aes(x=year, y=average_enterocococci_cfu_100ml))+
geom_col(mapping=aes(fill=site))
sydneybeaches_long %>%
pivot_longer(-site,
names_to = "year",
values_to = "average_enterocococci_cfu_100ml") %>%
ggplot(mapping=aes(x=year, y=average_enterocococci_cfu_100ml))+
geom_col(mapping=aes(fill=site))
