server <- function(input, output, session) {
output$plot <- renderPlot({
ggplot(data=penguins,
aes_string(x=input$x, y=input$y, color="species"))+
geom_point(na.rm=T)
})
}
shinyApp(ui, server)
library(shiny)
ui <- fluidPage(
