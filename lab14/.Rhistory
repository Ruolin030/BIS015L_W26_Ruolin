library(shiny)
ui <- fluidPage(
selectInput("x",
"Select X Variable",
choices = c("bill_length_mm",
"bill_depth_mm",
"flipper_length_mm",
"body_mass_g"),
selected = "bill_length_mm"),
selectInput("y",
"Select Y Variable",
choices = c("bill_length_mm",
"bill_depth_mm",
"flipper_length_mm",
"body_mass_g"),
selected = "bill_length_mm")
)
server <- function(input, output, session) {
reactive({input$x
input$y
})
}
shinyApp(ui, server)
