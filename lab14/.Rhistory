map1 <- get_stadiamap(bbox, maptype="stamen_terrain", zoom = 7) #zoom: quality of the map (higher zoom number,)
ggmap(map1)
ggmap(map1)+
geom_point(data=spider, aes(longtide, latitude), size=0.75, color="black", alpha=0.8)+
labs(x="Longitude", y="Latitude", title="CA Usofila Records")
ggmap(map1)+
geom_point(data=spiders, aes(longtide, latitude), size=0.75, color="black", alpha=0.8)+
labs(x="Longitude", y="Latitude", title="CA Usofila Records")
ggmap(map1)+
geom_point(data=spiders, aes(longitude, latitude), size=0.75, color="black", alpha=0.8)+
labs(x="Longitude", y="Latitude", title="CA Usofila Records")
