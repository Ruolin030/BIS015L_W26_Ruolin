library(tidyverse)
library(janitor)
options(scipen = 999)
gapminder <- read_csv("data/gapminder.csv") %>%
clean_names() %>%
filter(between(year, 1925, 2025))
glimpse(gapminder)
summary(gapminder)
glimpse(gapminder)
gapminder %>%
count(country)
View(gapminder)
gapminder %>%
filter(year %in% c(1925, 2025)) %>%
group_by(country) %>%
summarize(pop=sum(pop))
gapminder %>%
filter(year %in% c(1925, 2025)) %>%
group_by(country) %>%
summarize(pop=sum(pop)) %>%
arrange(desc(pop))
gapminder %>%
filter(year %in% c(1925, 2025)) %>%
mutate(year=factor(year)) %>%
group_by(country) %>%
summarize(pop=sum(pop)) %>%
arrange(desc(pop))
gapminder %>%
filter(year %in% c(1925, 2025)) %>%
mutate(year=factor(year)) %>%
group_by(country) %>%
summarize(pop=subtract(pop)) %>%
arrange(desc(pop))
gapminder %>%
filter(year %in% c(1925, 2025)) %>%
mutate(year=factor(year)) %>%
group_by(country) %>%
summarize(pop=subtract(pop)) %>%
arrange(desc(pop))
gapminder %>%
filter(year %in% c(1925, 2025)) %>%
mutate(year=factor(year)) %>%
group_by(country) %>%
summarize(pop=mins(pop)) %>%
arrange(desc(pop))
gapminder %>%
filter(year %in% c(1925, 2025)) %>%
mutate(year=factor(year)) %>%
group_by(country) %>%
summarize(pop=substr(pop)) %>%
arrange(desc(pop))
