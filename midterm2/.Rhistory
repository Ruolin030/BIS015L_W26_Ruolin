library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
register_stadiamaps("98fb3221-376e-43ba-9338-70c989f39bef", write = FALSE)
polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class==c("A", "S")) %>%
mutate(sex=toupper(sex),
age_class=toupper(age_class))
names(polar_bears)
glimpse(polar_bears)
polar_bears <- polar_bears %>%
replace_with_na(replace = list(mating="unknown",
denning="unknown"))
polar_bears %>%
miss_var_summary()
polar_bears %>%
ggplot(aes(x=popn, fill=sex))+
geom_bar(position = "dodge")+
labs(title = "Number of Males and Females by population", x="population", y="number of males and females")
polar_bears <- polar_bears %>%
separate(capture_date, into = c("year", "month", "day")) %>%
mutate(year=as.numeric(year))
polar_bears %>%
group_by(year) %>%
summarize(number=n()) %>%
ggplot(aes(x=year, y=number))+
geom_line()+
geom_point(aes(color=popn))
polar_bears %>%
summarize(number=n())
polar_bears %>%
group_by(year, popn) %>%
summarize(number=n())
polar_bears %>%
group_by(year, popn) %>%
summarize(number=n()) %>%
ggplot(aes(x=year, y=number))+
geom_line()+
geom_point()
polar_bears %>%
group_by(year, popn) %>%
summarize(number=n()) %>%
ggplot(aes(x=year, y=number))+
geom_line(aes(color=popn))+
geom_point()
polar_bears %>%
group_by(year, popn) %>%
summarize(number=n()) %>%
ggplot(aes(x=year, y=number)+
geom_line(aes(color=popn))+
geom_point(size=0.2)
polar_bears %>%
group_by(year, popn) %>%
summarize(number=n()) %>%
ggplot(aes(x=year, y=number))+
geom_line(aes(color=popn))+
geom_point(size=0.2)
polar_bears %>%
group_by(year, popn) %>%
summarize(number=n()) %>%
ggplot(aes(x=year, y=number))+
geom_line(aes(color=popn))+
geom_point(size=0.5)
polar_bears %>%
summarize(min_urea_nitrogen=min(urea_nitrogen),
median_urea_nitrogen=median(urea_nitrogen),
mean_urea_nitrogen=mean(urea_nitrogen),
max_urea_nitrogen=max(urea_nitrogen),
min_creatinine=min(creatinine),
median_creatinine=median(creatinine),
mean_creatinine=mean(creatinine),
max_creatinine=max(creatinine))
polar_bears <- polar_bears%>%
mutate(un_creat_ratio=(urea_nitrogen*0.466)/creatinine)
polar_bears <- polar_bears %>%
mutate(fasting=case_when(un_creat_ratio<=10 ~ "yes",
un_creat_ratio>10 ~ "no"))
polar_bears %>%
filter(fasting=="yes") %>%
group_by(year, popn) %>%
summarize(number=n()) %>%
ggplot(aes(x=number, color=popn))+
geom_line()+
geom_point()
polar_bears %>%
filter(fasting=="yes") %>%
group_by(year, popn) %>%
summarize(number=n())
polar_bears %>%
filter(fasting=="yes") %>%
group_by(year, popn) %>%
summarize(number=n()) %>%
ggplot(aes(x=number, y=number, color=popn))+
geom_line()+
geom_point()
polar_bears %>%
filter(fasting=="yes") %>%
group_by(year, popn) %>%
summarize(number=n()) %>%
ggplot(aes(x=number, y=number))+
geom_line()+
geom_point()
polar_bears %>%
filter(fasting=="yes") %>%
group_by(year, popn) %>%
summarize(number=n()) %>%
ggplot(aes(x=year, y=number, color=popn))+
geom_line()+
geom_point()
polar_bears %>%
group_by(year, popn) %>%
summarize(number=n()) %>%
ggplot(aes(x=year, y=number, color=popn))+
geom_line()+
geom_point()
polar_bears %>%
select(lat, long) %>%
summary()
lat <- c(62.46, 72.70)
long <- c(-172.2 , -134.8)
bbox <- make_bbox(long, lat, f=0.05)
map1 <- get_stadiamap(bbox, maptype = "stamen_terrain", zoom=5)
ggmap(map1)
ggmap(map1)+
geom_point(data=polar_bears, mapping=aes(lat, long, color=popn), size=0.75)
library(shiny)
ui <- fluidPage(
selectInput("y",
"Select Fill Variable",
choices = c("sex",
"mating",
"age_class",
"denning",
"fasting"),
selected = "sex"),
plotOutput("plot", width = "600px", height = "500px")
)
server <- function(input, output, session) {
output$plot <- renderPlot({
polar_bears %>%
ggplot(aes(x=popn,
y=.data[[input$y]]))+
geom_boxplot()
})
}
shinyApp(ui, server)
knitr::opts_chunk$set(echo = TRUE)
