x <- seq(-4, 4, length = 1000)
y <- dt(x, df = 8)
plot(x, y, type = "l",
main = "Sampling Distribution of the Mean",
xlab = "t value",
ylab = "Density")
set.seed(1)
data <- c(5,7,8,9,10,12,13,14,15)
means <- replicate(10000, mean(sample(data, replace = TRUE)))
hist(means, probability = TRUE,
main = "Simulated Sampling Distribution of Ybar",
xlab = "Sample Mean")
plot(x, y, type = "l",
main = "Sampling Distribution of Ybar",
xlab = "Ybar",
ylab = "Density")
plot(x, y, type = "l",
main = "Sampling Distribution of Mean Difference",
xlab = "Mean Difference (Y1 - Y2)",
ylab = "Density")
# parameters
mu_true <- 3      # true mean difference
sigma <- 4        # true standard deviation
n <- 9            # number of pairs
# standard error
SE <- sigma / sqrt(n)
# create x values
x <- seq(mu_true - 4*SE, mu_true + 4*SE, length = 1000)
# normal distribution
y <- dnorm(x, mean = mu_true, sd = SE)
# plot
plot(x, y, type = "l",
main = "Sampling Distribution of Mean Difference",
xlab = "Mean Difference (D̄)",
ylab = "Density")
# plot
plot(x, y, type = "l",
main = "Sampling Distribution of Mean Difference",
xlab = "Mean Difference (d̄)",
ylab = "Density")
# given values
dbar <- 22.9
sd_d <- 59.3
n <- 9
# standard error
SE <- sd_d / sqrt(n)
# x values
x <- seq(dbar - 4*SE, dbar + 4*SE, length = 1000)
# normal approximation of sampling distribution
y <- dnorm(x, mean = dbar, sd = SE)
# plot
plot(x, y, type = "l",
main = "Sampling Distribution of Mean Difference",
xlab = "Mean Difference (d̄)",
ylab = "Density")
# 1. Define the given statistics
n <- 9
mean1 <- 520.4
sd1 <- 57.1
mean2 <- 497.6
sd2 <- 47.3
mean_diff <- 22.9
sd_diff <- 59.3
# 2. Calculate Standard Errors (SE = SD / sqrt(n))
se1 <- sd1 / sqrt(n)
se2 <- sd2 / sqrt(n)
se_diff <- sd_diff / sqrt(n)
# 3. Create a range for the x-axis covering all distributions
x <- seq(-50, 650, length.out = 1000)
# 4. Calculate normal density curves
y1 <- dnorm(x, mean = mean1, sd = se1)
y2 <- dnorm(x, mean = mean2, sd = se2)
y_diff <- dnorm(x, mean = mean_diff, sd = se_diff)
# 5. Plotting
plot(x, y1, type = "l", col = "blue", lwd = 2, xlim = c(-50, 600),
main = "Distributions of Sample Means",
xlab = "Weight Gain (lbs)", ylab = "Density")
lines(x, y2, col = "red", lwd = 2)
lines(x, y_diff, col = "darkgreen", lwd = 2)
# Add a legend
legend("topleft", legend = c(expression(bar(Y)[1]), expression(bar(Y)[2]), expression(bar(Y)[1] - bar(Y)[2])),
col = c("blue", "red", "darkgreen"), lwd = 2)
# Add a vertical line at 0 for reference
abline(v = 0, lty = 2, col = "gray")
