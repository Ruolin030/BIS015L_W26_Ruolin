library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
register_stadiamaps("98fb3221-376e-43ba-9338-70c989f39bef", write = FALSE)
polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class==c("A", "S")) %>%
mutate(sex=toupper(sex),
age_class=toupper(age_class))
names(polar_bears)
glimpse(polar_bears)
polar_bears <- polar_bears %>%
replace_with_na(replace = list(mating="unknown",
denning="unknown"))
polar_bears %>%
miss_var_summary()
polar_bears %>%
ggplot(aes(x=popn, fill=sex))+
geom_bar(position = "dodge")+
labs(title = "Number of Males and Females by population", x="population", y="number of males and females")
polar_bears <- polar_bears %>%
separate(capture_date, into = c("year", "month", "day"))
polar_bears %>%
group_by(year) %>%
summarize(number=n()) %>%
ggplot(aes(x=year))+
geom_line()
polar_bears %>%
group_by(year) %>%
summarize(number=n()) %>%
ggplot(aes(x=year, y=number))+
geom_line()
polar_bears %>%
group_by(year) %>%
summarize(number=n())
polar_bears %>%
group_by(year) %>%
summarize(number=n()) %>%
ggplot(aes(x=year, y=number))+
geom_col()
