polar_bears %>%
summarize(min_urea_nitrogen=min(urea_nitrogen),
median_urea_nitrogen=median(urea_nitrogen),
mean_urea_nitrogen=mean(urea_nitrogen),
max_urea_nitrogen=max(urea_nitrogen),
min_creatinine=min(creatinine),
median_creatinine=median(creatinine),
mean_creatinine=mean(creatinine),
max_creatinine=max(creatinine))
polar_bears <- polar_bears%>%
mutate(un_creat_ratio=(urea_nitrogen*0.466)/creatinine)
polar_bears <- polar_bears %>%
mutate(fasting=case_when(un_creat_ratio<=10 ~ "yes",
un_creat_ratio>10 ~ "no"))
polar_bears %>%
filter(fasting=="yes") %>%
group_by(year, popn) %>%
summarize(number=n()) %>%
ggplot(aes(x=year, y=number, color=popn))+
geom_line()+
geom_point()+
labs(title="Number of Fasting Bears Sampled by Year", x="Year", y="Number of Bears", color="Population")+
theme(axis.text.x = element_text(angle=60, hjust=1))
