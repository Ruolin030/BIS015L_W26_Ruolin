group_by(year, popn) %>%
summarize(number=n()) %>%
ggplot(aes(x=year, y=number, color=popn))+
geom_line()+
geom_point()+
scale_x_continuous(breaks=1980:2020, minor_breaks = 1)
labs(title="Number of Bears Sampled by Year", x="Year", y="Number of Bears", color="Population")
